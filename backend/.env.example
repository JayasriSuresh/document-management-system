# ── Application Environment ──────────────────────────────────────────────────
# Set to 'production' in deployed environments to enforce strict startup checks
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dms_user:dms_password@localhost:5433/dms_db

# ── Security & Authentication ────────────────────────────────────────────────
# In production, must be at least 32 random characters: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-dms-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_AUDIENCE=dms-portal

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Wildcard '*' only permitted in development
CORS_ORIGINS=*

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage/documents

# ── AI Document Extraction ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
